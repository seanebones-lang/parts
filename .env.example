# Copy to .env and fill in real values. Never commit secrets.

# --- Core API ---
DEBUG=true
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Database (docker-compose defaults; override in production) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dealership_parts
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- LLM providers (optional; offline retrieval works without these) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Embeddings / vector backend ---
# sentence-transformers local default: BAAI/bge-small-en-v1.5
EMBEDDING_PROVIDER=sentence-transformers
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PARRTS_EMBEDDER=hash
PGVECTOR_ENABLED=false
VECTOR_BACKEND=auto
PGVECTOR_HNSW=true
AUTH_MODE=demo
RATE_LIMIT_ENABLED=true

# --- Observability (optional) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LOG_LEVEL=INFO

# --- Payments / shipping (demo mocks unless keys present) ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
EASYPOST_API_KEY=
