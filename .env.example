# Copy to .env and fill in real values. Never commit secrets.

# --- Core API / runtime ---
# ENVIRONMENT: development | staging | production
ENVIRONMENT=development
DEBUG=true
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# SECRET_KEY is REQUIRED in production (docker-compose.prod.yml and AUTH_MODE=production).
# Generate e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Do not use the placeholder below outside local demo.
SECRET_KEY=change-me-generate-a-long-random-secret

# --- Database (docker-compose defaults; override in production) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dealership_parts
POSTGRES_USER=postgres
# REQUIRED in production — set a strong password; docker-compose.prod.yml has no weak default.
POSTGRES_PASSWORD=change-me

# --- DMS storage backend ---
# DMS_BACKEND=sqlite (default embedded) | postgres (server multi-user)
# When postgres: set DMS_DATABASE_URL or rely on POSTGRES_* above, then:
#   parrts dms migrate
#   parrts dms --backend postgres seed --reindex
DMS_BACKEND=sqlite
# DMS_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/dealership_parts

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- LLM providers (optional; offline retrieval works without these) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Embeddings / vector backend ---
# sentence-transformers local default: BAAI/bge-small-en-v1.5
EMBEDDING_PROVIDER=sentence-transformers
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PARRTS_EMBEDDER=hash
PGVECTOR_ENABLED=false
VECTOR_BACKEND=auto
PGVECTOR_HNSW=true
# AUTH_MODE: demo | production
#   demo (default) — mutating routes open without Bearer (JWT optional if sent)
#   production — mutating routes use require_user_if_production → JWT required
# Pattern: Depends(require_user_if_production) from app.api.deps
AUTH_MODE=demo
RATE_LIMIT_ENABLED=true

# --- Observability (optional) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LOG_LEVEL=INFO

# --- Email desk (production) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_USE_TLS=true
# Only auto-SMTP greens when true AND SMTP creds set
EMAIL_AUTO_SEND=false
MAX_EMAILS_PER_BATCH=10

# --- Payments / shipping (activate with keys) ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
EASYPOST_API_KEY=

# --- OEM live feed (optional; never invents catalog without URL) ---
# Celery beat fires oem.scheduled_sync nightly (default 06:00 UTC).
# Task skips cleanly when OEM_FEED_URL is empty.
OEM_FEED_URL=
OEM_FEED_TOKEN=
# After successful HTTP sync, rebuild RAG index when true
OEM_SYNC_REINDEX=false
# Cron overrides for beat (UTC)
OEM_SYNC_CRON_HOUR=6
OEM_SYNC_CRON_MINUTE=0
